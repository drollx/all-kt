.hover{
background-color: #e5bc64(255, 255, 255);
color: rgb(136, 65, 18);
font-size: medium;
border: 2px;
border-radius: 50px;
transition: 0,5 ease;
text-align: center;
}

.hover:hover{
    transform: scale(1.1);
    background-color: #FF6B00;
}


.text-overlay2 {
  text-align: center;
  position: absolute;
  top: 20%;
  left: 10%;
  color: #FFFFFF;
  font-size: 100px;

  .container {
  width: 90%;        
  max-width: 1200%; 
  margin: 0 auto;  
}

  .cards {
  display: flex;
  flex-wrap: wrap;   
  gap: 20px;         
}

.card {
  flex: 1 1 300px;  
  min-width: 250px;  
}

  @keyframes fade-in-up {
  0% {
    opacity: 0;
    transform: translateY(30px);
  }
  100% {
    opacity: 1;
    transform: translateY(0);
  }
}

.hover {
  animation: fade-in-up 0.6s ease-out;
}
