const cartIcon = document.querySelector("#cart-icon");
const cart = document.querySelector(".cart");
const cartClose = document.querySelector("#cart-close");

cartIcon.addEventListener("click", () => {
    cart.classList.add("active");
});

cartClose.addEventListener("click", () => {
    cart.classList.remove("active");
});

const addCartButtons = document.querySelectorAll(".add-cart");

addCartButtons.forEach(button => {
    button.addEventListener("click", event => {
        const productBox = event.target.closest(".product-box");
        addToCart(productBox);
    });
});

const addToCart = productBox => {
    const productImgSrc = productBox.querySelector("img").src;
    const productTitle = productBox.querySelector(".product-title").textContent;
    const productPrice = productBox.querySelector(".price").textContent;

    const cartItems = document.querySelectorAll(".cart-product-title");

    for (let item of cartItems) {
        if (item.textContent === productTitle) {
            alert("Этот товар уже добавлен в корзину!");
            return;
        }
    }

    const cartBox = document.createElement("div");
    cartBox.classList.add("cart-box");

    cartBox.innerHTML = `
        <img src="${productImgSrc}" class="cart-img">

        <div class="cart-detail">
            <h2 class="cart-product-title">${productTitle}</h2>

            <span class="cart-price">${productPrice}</span>

            <div class="cart-quantity">
                <button class="decrement">-</button>
                <span class="number">1</span>
                <button class="increment">+</button>
            </div>
        </div>

        <i class="ri-delete-bin-5-line cart-remove"></i>
    `;

    const cartContent = document.querySelector(".cart-content");
    cartContent.appendChild(cartBox);

    cartBox.querySelector(".cart-remove").addEventListener("click", () => {
        cartBox.remove();
        updateTotal();
        updateCartCount();
    });

    cartBox.querySelector(".increment").addEventListener("click", () => {
        const number = cartBox.querySelector(".number");
        number.textContent = parseInt(number.textContent) + 1;
        updateTotal();
        updateCartCount();
    });

    cartBox.querySelector(".decrement").addEventListener("click", () => {
        const number = cartBox.querySelector(".number");
        let quantity = parseInt(number.textContent);

        if (quantity > 1) {
            quantity--;
            number.textContent = quantity;
            updateTotal();
            updateCartCount();
        }
    });

    updateTotal();
    updateCartCount();
};

const updateTotal = () => {
    const cartBoxes = document.querySelectorAll(".cart-box");
    const totalPriceElement = document.querySelector(".total-price");

    let total = 0;

    cartBoxes.forEach(cartBox => {
        const priceElement = cartBox.querySelector(".cart-price");
        const quantityElement = cartBox.querySelector(".number");

        const price = parseFloat(
            priceElement.textContent.replace("$", "")
        );

        const quantity = parseInt(quantityElement.textContent);

        total += price * quantity;
    });

    totalPriceElement.textContent = "$" + total;
};

const updateCartCount = () => {
    const cartBoxes = document.querySelectorAll(".cart-box");
    const cartItemCount = document.querySelector(".cart-item-count");

    let quantity = 0;

    cartBoxes.forEach(cartBox => {
        const number = cartBox.querySelector(".number");
        quantity += parseInt(number.textContent);
    });

    cartItemCount.textContent = quantity;

    if (quantity > 0) {
        cartItemCount.style.visibility = "visible";
    } else {
        cartItemCount.style.visibility = "hidden";
    }
};

const buyButton = document.querySelector(".btn-buy");

buyButton.addEventListener("click", () => {
    const cartBoxes = document.querySelectorAll(".cart-box");

    if (cartBoxes.length === 0) {
        alert("Корзина пустая!");
        return;
    }

    alert("Спасибо за покупку!");

    document.querySelector(".cart-content").innerHTML = "";

    updateTotal();
    updateCartCount();
});

const buyButtons = document.querySelectorAll(".buy");

buyButtons.forEach(button => {
    button.addEventListener("click", () => {
        const counter = button.parentElement.querySelector(".counter");
        counter.textContent = parseInt(counter.textContent) + 1;
    });
});
